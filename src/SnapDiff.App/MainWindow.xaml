<Window x:Class="SnapDiff.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapDiff" Height="600" Width="920"
        MinHeight="520" MinWidth="780"
        Background="#F3F4F6"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <!-- 说明：界面上所有文字都在 Loc.cs 双语字典里，由后台代码设置（本文件只负责布局与样式）。 -->
    <Window.Resources>

        <!-- ============ 设计系统：Windows 原生现代风 ============ -->
        <!-- 卡片：白底、细边框、8px 圆角（不用投影，避免文字发虚） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- 主按钮：强调色底、白字、悬停加深、按下更深 -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#0078D7" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#AAB4BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：白底细边框，悬停浅灰、按下更深 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#C9CFD6" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E9F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小号次按钮 -->
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- 侧栏导航项：圆角高亮 + 悬停过渡 + 选中底色 #DCEBF7 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="12,10" Margin="0,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EDF2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBF7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框统一高度 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#C9CFD6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 结果树行：行高 30、悬停高亮、只有横向分隔线（自定义模板，保持虚拟化） -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderThickness="0,0,0,1" BorderBrush="#EEF0F3"
                                    MinHeight="30" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="14" Height="30">
                                                    <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="#6B7280"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F6FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCEBF7"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 侧栏 ============ -->
        <DockPanel Grid.Column="0" Margin="14,14,6,14" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <!-- 应用标识 -->
                <StackPanel Orientation="Horizontal" Margin="12,4,0,0">
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#0078D7" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#1F2328"/>
                </StackPanel>

                <!-- 语言切换 -->
                <ComboBox x:Name="LangBox" Width="170" Height="28" Margin="12,14,0,0"
                          HorizontalAlignment="Left" SelectionChanged="OnLangSelectionChanged">
                    <ComboBoxItem x:Name="LangZhItem"/>
                    <ComboBoxItem x:Name="LangEnItem"/>
                </ComboBox>

                <!-- 步骤导航（完成态打勾） -->
                <ListBox x:Name="Nav" Margin="12,18,0,0" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnNavSelectionChanged">
                    <ListBoxItem Style="{StaticResource NavItem}" IsSelected="True">
                        <DockPanel>
                            <TextBlock x:Name="StepCheck1" DockPanel.Dock="Right" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0F7B0F"
                                       VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavText1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}">
                        <DockPanel>
                            <TextBlock x:Name="StepCheck2" DockPanel.Dock="Right" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0F7B0F"
                                       VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavText2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}">
                        <DockPanel>
                            <TextBlock x:Name="StepCheck3" DockPanel.Dock="Right" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0F7B0F"
                                       VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavText3" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavItem}">
                        <DockPanel>
                            <TextBlock x:Name="StepCheck4" DockPanel.Dock="Right" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#0F7B0F"
                                       VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       VerticalAlignment="Center" Foreground="#0078D7"/>
                            <TextBlock x:Name="NavText4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 关于 -->
                <Button x:Name="AboutBtn" Style="{StaticResource SmallBtn}" Click="OnAbout"
                        HorizontalAlignment="Left" Margin="12,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AboutBtnText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 侧栏底部：只读状态指示灯 -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E3E6EA" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#0F7B0F" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SidebarReadonly" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 占位撑开 -->
            <Grid/>
        </DockPanel>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Column="1" Margin="6,14,14,14">

            <!-- —— 第 1 步：选范围拍快照 A —— -->
            <Grid x:Name="Step1Panel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Step1Input">
                        <!-- 注册表范围卡 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#0078D7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GroupRegistry" FontWeight="SemiBold" Foreground="#1F2328"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="HkcuCheck" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="HklmCheck" VerticalAlignment="Center"/>
                                </WrapPanel>
                                <TextBlock x:Name="AdminHint" Foreground="#B26B00" TextWrapping="Wrap"
                                           Margin="0,6,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="ExclusionLabel" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,10,0,4"/>
                                <TextBox x:Name="ExclusionBox" Height="92" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="BtnResetExclusions" Style="{StaticResource SmallBtn}" Click="OnResetExclusions"/>
                                    <TextBlock x:Name="ExclusionHint" Foreground="#9AA1A9" TextWrapping="Wrap"
                                               MaxWidth="470" Margin="10,2,0,0" VerticalAlignment="Center"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 文件夹范围卡 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#0078D7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GroupFolders" FontWeight="SemiBold" Foreground="#1F2328"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ListBox x:Name="DirList" Height="92" BorderBrush="#C9CFD6" BorderThickness="1"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="BtnAddFolder" Style="{StaticResource SmallBtn}" Click="OnAddDir"/>
                                    <Button x:Name="BtnRemoveFolder" Style="{StaticResource SmallBtn}" Click="OnRemoveDir" Margin="6,0,0,0"/>
                                    <Button x:Name="BtnResetFolders" Style="{StaticResource SmallBtn}" Click="OnResetDirs" Margin="6,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 高级选项卡 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="#0078D7" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GroupAdvanced" FontWeight="SemiBold" Foreground="#1F2328"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="HashCheck"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="0,2,0,0">
                    <Button x:Name="BtnStartA" Style="{StaticResource PrimaryBtn}" Click="OnStartSnapshotA" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="ProgressPanelA" Visibility="Collapsed" Margin="0,10,0,0">
                        <ProgressBar Height="4" IsIndeterminate="True"/>
                        <TextBlock x:Name="ProgressTextA" Margin="0,6,0,0" Foreground="#6B7280" FontSize="11.5"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnCancelA" Style="{StaticResource SmallBtn}" Click="OnCancelScanA"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- —— 第 2 步：去安装/运行软件 —— -->
            <Grid x:Name="Step2Panel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Padding="32,28" MaxWidth="640"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#0078D7" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Step2Header" FontSize="19" FontWeight="Bold" Foreground="#1F2328"
                                       Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="Step2Body" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock x:Name="Step2SavedTo" Foreground="#9AA1A9" FontSize="11.5" TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock x:Name="SnapshotAPathText" FontFamily="Consolas" FontSize="11.5" Foreground="#1F2328"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnGoStep3" Style="{StaticResource PrimaryBtn}" Click="OnGoToStep3"/>
                            <Button x:Name="BtnBackStep1" Style="{StaticResource GhostBtn}" Click="OnRestartFromStep2" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- —— 第 3 步：拍快照 B —— -->
            <Grid x:Name="Step3Panel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="Step3Header" FontWeight="SemiBold" Foreground="#1F2328" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ScopeLabel" Foreground="#9AA1A9" FontSize="11.5" Margin="0,10,0,4"/>
                                <TextBlock x:Name="ScopeSummaryText" FontFamily="Consolas" FontSize="11.5"
                                           Foreground="#444444" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnStartB" Style="{StaticResource PrimaryBtn}" Click="OnStartSnapshotB" HorizontalAlignment="Left"/>
                        <StackPanel x:Name="ProgressPanelB" Visibility="Collapsed" Margin="0,10,0,0">
                            <ProgressBar Height="4" IsIndeterminate="True"/>
                            <TextBlock x:Name="ProgressTextB" Margin="0,6,0,0" Foreground="#6B7280" FontSize="11.5"
                                       FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="BtnCancelB" Style="{StaticResource SmallBtn}" Click="OnCancelScanB"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- —— 第 4 步：对比结果 —— -->
            <Grid x:Name="Step4Panel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 统计卡：新增 / 删除 / 修改 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Padding="16,10" Width="150">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="34" Background="#0F7B0F" CornerRadius="2" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="StatAddedLabel" Foreground="#6B7280" FontSize="11.5"/>
                                <TextBlock x:Name="StatAddedValue" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#0F7B0F" Text="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,10" Width="150" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="34" Background="#C50F1F" CornerRadius="2" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="StatRemovedLabel" Foreground="#6B7280" FontSize="11.5"/>
                                <TextBlock x:Name="StatRemovedValue" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#C50F1F" Text="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16,10" Width="150" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="34" Background="#0078D7" CornerRadius="2" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock x:Name="StatModifiedLabel" Foreground="#6B7280" FontSize="11.5"/>
                                <TextBlock x:Name="StatModifiedValue" FontFamily="Consolas" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#0078D7" Text="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SummaryDetail" VerticalAlignment="Bottom" Margin="16,0,0,6"
                               Foreground="#9AA1A9" FontSize="11.5" TextWrapping="Wrap" MaxWidth="240"/>
                </StackPanel>

                <!-- 工具卡：搜索 + 导出 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock x:Name="SearchLabel" VerticalAlignment="Center" Foreground="#6B7280"/>
                            <TextBox x:Name="SearchBox" Width="300" Margin="8,0,0,0" TextChanged="OnSearchChanged"/>
                            <Button x:Name="BtnClearSearch" Style="{StaticResource SmallBtn}" Click="OnClearSearch" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="BtnExportMd" Style="{StaticResource SmallBtn}" Click="OnExportMarkdown"/>
                            <Button x:Name="BtnExportCsv" Style="{StaticResource SmallBtn}" Click="OnExportCsv" Margin="6,0,0,0"/>
                            <Button x:Name="BtnRestart" Style="{StaticResource SmallBtn}" Click="OnRestart" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 结果树卡片（内含空状态提示） -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TreeView x:Name="ResultTree" Background="Transparent" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"/>
                        <TextBlock x:Name="ResultEmpty" Text="…" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#B6BCC4" FontSize="13" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
